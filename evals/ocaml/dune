(library
 (name genius_evals_kernel)
 (public_name genius_evals_kernel))

(rule
 (target build_info.ml)
 (deps (source_tree .))
 (action
  (with-stdout-to %{target}
   (run %{exe:tools/embed_sources.exe} %{deps}))))

(rule
 (target public-interface.deps)
 (deps genius_evals_kernel.ml)
 (action
  (with-stdout-to %{target}
   (run %{exe:tools/bindings.exe} --dependencies %{deps} Genius_evals_kernel))))

(rule
 (target genius_evals_kernel.mli)
 (deps (:interfaces (include public-interface.deps)))
 (action
  (with-stdout-to %{target}
   (run %{exe:tools/bindings.exe} --interface Genius_evals_kernel %{interfaces}))))
