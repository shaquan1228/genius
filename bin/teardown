#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
readonly ROOT_DIR
# shellcheck source=evals/bin/lib/common.bash
source "$ROOT_DIR/evals/bin/lib/common.bash"
# shellcheck source=bin/lib/identity.bash
source "$ROOT_DIR/bin/lib/identity.bash"

usage() {
  cat <<'HELP'
Usage: bin/teardown [--yes] [--quiet]
Remove Genius identity from Claude Code and this checkout's Cursor rules.
The default is a dry run; no interactive prompt is required.

Examples:
  bin/teardown
  bin/teardown --yes

Options:
  -y, --yes      Apply the removal (--confirm remains an alias).
  -n, --dry-run  Describe changes without writing files (default).
  -q, --quiet    Suppress progress messages.
  -h, --help     Show this help, without changing anything.

Help: https://github.com/shaquan1228/genius#readme
HELP
}

main() {
  cli_help "$@"
  local apply=0 dry_run=0
  while (($#)); do
    case $1 in
      -y | --yes | --confirm) apply=1 ;;
      -n | --dry-run) dry_run=1 ;;
      -q | --quiet) CLI_QUIET=1 ;;
      --)
        shift
        cli_no_arguments "$@"
        break
        ;;
      *) cli_usage_error "Unexpected argument: $1" ;;
    esac
    shift
  done
  identity_preflight "$ROOT_DIR"
  local claude=$HOME/.claude/CLAUDE.md cursor=$ROOT_DIR/.cursor/rules/genius.mdc
  if ((! apply || dry_run)); then
    printf 'Would remove GENIUS blocks from %s\nWould remove %s\n' "$claude" "$cursor"
    cli_info 'Dry run. Pass --yes to apply.'
    return
  fi
  if [[ -f $claude ]]; then
    identity_claude "$claude" remove "$ROOT_DIR/docs/identity.md"
    cli_info "Removed managed blocks from $claude"
  fi
  if [[ -f $cursor ]]; then
    rm -- "$cursor"
    cli_info "Removed $cursor"
  fi
  cli_info 'Restart Claude Code or Cursor to clear the identity.'
}

cli_init
main "$@"
