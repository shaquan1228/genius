#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
readonly ROOT_DIR
# shellcheck source=evals/bin/lib/common.bash
source "$ROOT_DIR/evals/bin/lib/common.bash"
# shellcheck source=bin/lib/identity.bash
source "$ROOT_DIR/bin/lib/identity.bash"

usage() {
  cat <<'HELP'
Usage: bin/setup [--dry-run] [--quiet]
Install Genius identity in Claude Code and this checkout's Cursor rules.

Examples:
  bin/setup --dry-run
  bin/setup

Options:
  -n, --dry-run  Describe changes without writing files.
  -q, --quiet    Suppress progress messages.
  -h, --help     Show this help, without changing anything.

Existing CLAUDE.md content is preserved; running again updates the managed block.
Help: https://github.com/shaquan1228/genius#readme
HELP
}

main() {
  cli_help "$@"
  local dry_run=0
  while (($#)); do
    case $1 in
      -n | --dry-run) dry_run=1 ;;
      -q | --quiet) CLI_QUIET=1 ;;
      --)
        shift
        cli_no_arguments "$@"
        break
        ;;
      *) cli_usage_error "Unexpected argument: $1" ;;
    esac
    shift
  done
  identity_preflight "$ROOT_DIR"
  local identity=$ROOT_DIR/docs/identity.md
  local claude=$HOME/.claude/CLAUDE.md cursor=$ROOT_DIR/.cursor/rules/genius.mdc
  [[ -f $identity ]] || cli_die "Identity source not found: $identity"
  [[ $identity != *$'\n'* ]] || cli_die 'Identity paths cannot contain newlines.'
  if ((dry_run)); then
    printf 'Would update %s\nWould write %s\n' "$claude" "$cursor"
    return
  fi
  mkdir -p -- "$(dirname -- "$claude")" "$(dirname -- "$cursor")"
  identity_claude "$claude" install "$identity"
  cli_info "Updated $claude"
  identity_cursor "$cursor" "$identity"
  cli_info "Updated $cursor"
  cli_info 'Restart Claude Code or Cursor to load the identity.'
}

cli_init
main "$@"
